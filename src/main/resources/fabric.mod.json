{
	"schemaVersion": 1,
	"id": "fpsreducerdisabler",
	"version": "${version}",
	"name": "Why not Keep Your FPS up?",
	"description": "Add an option to disable the FPS reducer from vanilla's video options.",
	"authors": [
		"NoTuring_Steve"
	],
	"contact": {
		"homepage": "https://nts-official.github.io/projects/fps-reducer-disabler",
		"sources": "https://github.com/NTS-Official/fps-reducer-disabler"
	},
	"license": "MIT",
	"icon": "assets/fpsreducerdisabler/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.nts.fpsreducerdisabler.WhyNotKeepYourFPSUp",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"fpsreducerdisabler.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.4-alpha.5",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"accessWidener": "fpsreducerdisabler.classtweaker"
}